# MeshPilot Environment Configuration
# Copy to .env and fill in your values before running docker compose up

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-string

# Signs the audit trail. Keep it safe and separate from database backups:
# anyone holding it could rewrite history, and losing it stops verification.
AUDIT_HMAC_KEY=change-me-to-a-different-random-string

# "production" refuses to start with placeholder secrets. Use "development"
# only for local testing.
MESHPILOT_ENV=production

# Admin account (created on first startup). Password: at least 12 characters.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-in-production

# ── Inference ─────────────────────────────────────────────────────────────────
# CPU threads for llama.cpp (set to physical core count)
LLAMA_THREADS=4

# Context window size (tokens)
LLAMA_CTX_SIZE=4096

# Batch size for continuous batching
LLAMA_BATCH_SIZE=512

# Max inference time before timeout (seconds)
INFERENCE_TIMEOUT_S=120

# ── Quantization ──────────────────────────────────────────────────────────────
# Default quantization bits for uploaded models (4 or 8)
AUTO_QUANT_BITS=4

# ── Services ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_USER=meshpilot
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=meshpilot
DATABASE_URL=postgresql+asyncpg://meshpilot:change-me-in-production@postgres:5432/meshpilot

# Internal service URLs (used by FastAPI to reach inference servers)
ONNX_URL=http://onnx:8090

# ── Privacy gateway ───────────────────────────────────────────────────────────
# Model used when a request asks for `auto` or `cloud` but has to run locally.
LOCAL_DEFAULT_MODEL=benchmark-mistral-7b

# Master switch for sending anything off this server. Requests can only reach
# the cloud when this is true AND the dashboard policy allows it. Leave false
# for fully on-premises deployments.
CLOUD_ROUTING_ENABLED=false
# Any OpenAI-compatible API, for example https://api.openai.com/v1
CLOUD_API_BASE=
CLOUD_API_KEY=
CLOUD_MODEL=
CLOUD_MAX_TOKENS_PARAM=max_tokens

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests per minute per API key (0 = unlimited)
RATE_LIMIT_RPM=60

# ── Storage ───────────────────────────────────────────────────────────────────
# Local path inside container for model files
MODEL_STORAGE_PATH=/data/models

# ── Savings panel pricing ─────────────────────────────────────────────────────
# List prices used for the dashboard's labelled cost estimates. Change these to
# match the cloud model and server each customer would actually compare against.
# Checked 2026-11-03: ai.google.dev/gemini-api/docs/pricing and EC2 on-demand pricing.
CLOUD_PRICE_LABEL=Gemini 2.5 Flash-Lite
CLOUD_INPUT_USD_PER_M=0.10
CLOUD_OUTPUT_USD_PER_M=0.40
SERVER_PRICE_LABEL=AWS m7i.xlarge on-demand, 4 vCPU
SERVER_USD_PER_HOUR=0.2016

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana admin password
GRAFANA_PASSWORD=change-me-in-production

# ── Optional: HTTPS ───────────────────────────────────────────────────────────
# Set to your domain for automatic Let's Encrypt SSL (requires port 443 open)
# DOMAIN=meshpilot.yourcompany.com
